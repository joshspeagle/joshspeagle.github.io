    "acc-panels":      { "dark": "#34d3e0", "light": "#0a7280" },
    "acc-posters":     { "dark": "#ff9d4d", "light": "#a2500a" },
    "acc-public":      { "dark": "#ff7eb6", "light": "#b1257a" },
    "acc-media":       { "dark": "#ff6b6b", "light": "#b3251f" },
    "acc-astronomy":   { "dark": "#5aa9ff", "light": "#1565c0" },
    "acc-statistics":  { "dark": "#a78bff", "light": "#5b43d6" },
    "acc-workshops":   { "dark": "#34d3e0", "light": "#0a7280" },
    "acc-press":       { "dark": "#ff7eb6", "light": "#b1257a" },
    "acc-teal":        { "dark": "#34d3e0", "light": "#0a7280" },
    "acc-student":     { "dark": "#ff9d4d", "light": "#a2500a" },
    "acc-postdoc":     { "dark": "#a99bff", "light": "#5b43d6" },

    "_role": "Authorship roles are NOT research areas, so the roles/RIQ series take a neutral LIGHTNESS ramp (even L* steps of 12-20 in both themes) rather than re-spending the four --cat-* hues on a second taxonomy. The figures add a hatch and direct labels as a second channel, so the series survive greyscale and colour-vision loss.",
    "role-primary":     { "dark": "#e6eafa", "light": "#1a1f2e" },
    "role-postdoc":     { "dark": "#bcc4e0", "light": "#414a66" },
    "role-student":     { "dark": "#939dc4", "light": "#6d7695" },
