{
  "_comment": "Design tokens (single source of truth). build_tokens.py -> assets/css/tokens.css. Design G — 'chips on the board': a cool navy substrate, copper for every trace/via/pin, amber ENERGY for pulses/lit pins/the one action per screen, and the four research-area tints as the only hue-coded taxonomy. acc-* are the declared taxonomy accents (talks types, teaching departments, service org-types, news types, software groups); role-* are the publication-figure series. Every light value of an acc-*/role-*/cat-* token clears 3:1 against the light --chip (#fffefb) so a 2px chip edge or a 7px pad swatch is visible.",
  "themeVarying": {
    "bg-0":        { "dark": "#06080f", "light": "#f6f6f1" },
    "bg-1":        { "dark": "#0a0e20", "light": "#efeee8" },
    "bg-2":        { "dark": "#0a1228", "light": "#e8e6dd" },
    "chip":        { "dark": "#0e1430", "light": "#fffefb" },
    "chip-2":      { "dark": "#131b3c", "light": "#f5f3ed" },
    "border":      { "dark": "rgba(255,255,255,0.08)", "light": "#e2dfd3" },
    "border-2":    { "dark": "rgba(255,255,255,0.16)", "light": "#cdc9bb" },
    "text":        { "dark": "#eef1fb", "light": "#14161d" },
    "text-2":      { "dark": "#aeb6d6", "light": "#46444c" },
    "text-3":      { "dark": "#8a97c2", "light": "#67645d" },

    "copper-rgb":  { "dark": "184 128 94", "light": "168 113 74" },
    "energy":      { "dark": "#f2b13a", "light": "#d9891a" },
    "energy-rgb":  { "dark": "242 177 58", "light": "217 137 26" },
    "energy-hot":  { "dark": "#fff4d6", "light": "#6b3a00" },
    "energy-ink":  { "dark": "#0b0704", "light": "#0b0704" },
    "_energy-text": "energy used as INK. The light --energy is a 2.8:1 fill colour, so text/focus rings take the darker 'lit text' value instead (9.3:1 on --chip); in dark it is --energy itself.",
    "energy-text": { "dark": "#f2b13a", "light": "#6b3a00" },

    "violet":      { "dark": "#8b7bff", "light": "#5b43d6" },
    "cyan":        { "dark": "#34d3e0", "light": "#0a7280" },
    "blue":        { "dark": "#5aa9ff", "light": "#1565c0" },

    "cat-sla":     { "dark": "#8b7bff", "light": "#5b43d6" },
